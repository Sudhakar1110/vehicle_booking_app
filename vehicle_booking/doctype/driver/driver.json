{
  "name": "Driver",
  "doctype": "DocType",
  "module": "Vehicle Booking",
  "is_submittable": 0,
  "track_changes": 1,
  "title_field": "driver_name",
  "search_fields": "driver_name, mobile_number",
  "fields": [
    {"fieldname": "driver_name", "fieldtype": "Data", "label": "Driver Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "mobile_number", "fieldtype": "Data", "label": "Mobile Number", "reqd": 1, "in_list_view": 1},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
    {"fieldname": "col_break1", "fieldtype": "Column Break"},
    {"fieldname": "license_number", "fieldtype": "Data", "label": "License Number", "reqd": 1},
    {"fieldname": "license_expiry", "fieldtype": "Date", "label": "License Expiry"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Available\nOn Trip\nOff Duty\nInactive", "default": "Available", "in_list_view": 1},
    {"fieldname": "section_break1", "fieldtype": "Section Break", "label": "Personal Details"},
    {"fieldname": "photo", "fieldtype": "Attach Image", "label": "Driver Photo"},
    {"fieldname": "date_of_birth", "fieldtype": "Date", "label": "Date of Birth"},
    {"fieldname": "address", "fieldtype": "Small Text", "label": "Address"},
    {"fieldname": "col_break2", "fieldtype": "Column Break"},
    {"fieldname": "experience_years", "fieldtype": "Int", "label": "Experience (Years)"},
    {"fieldname": "rating", "fieldtype": "Float", "label": "Rating (1-5)", "default": 5},
    {"fieldname": "total_trips", "fieldtype": "Int", "label": "Total Trips", "read_only": 1, "default": 0},
    {"fieldname": "assigned_vehicle", "fieldtype": "Link", "label": "Assigned Vehicle", "options": "Vehicle"},
    {"fieldname": "section_break2", "fieldtype": "Section Break", "label": "Documents"},
    {"fieldname": "aadhar_number", "fieldtype": "Data", "label": "Aadhar Number"},
    {"fieldname": "pan_number", "fieldtype": "Data", "label": "PAN Number"},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Vehicle Booking Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Vehicle Booking User", "read": 1}
  ]
}
