{
  "name": "Vehicle Booking Order",
  "doctype": "DocType",
  "module": "Vehicle Booking",
  "is_submittable": 1,
  "track_changes": 1,
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "title_field": "customer_name",
  "search_fields": "customer, vehicle, status",
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "VBO-.YYYY.-.#####", "default": "VBO-.YYYY.-.#####"},
    {"fieldname": "booking_status", "fieldtype": "Select", "label": "Booking Status",
     "options": "Draft\nConfirmed\nDriver Assigned\nIn Transit\nCompleted\nCancelled",
     "default": "Draft", "in_list_view": 1, "read_only": 1},
    {"fieldname": "col_break0", "fieldtype": "Column Break"},
    {"fieldname": "booking_date", "fieldtype": "Date", "label": "Booking Date", "reqd": 1, "default": "Today"},
    {"fieldname": "section_break1", "fieldtype": "Section Break", "label": "Customer Information"},
    {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Customer"},
    {"fieldname": "customer_name", "fieldtype": "Data", "label": "Customer Name", "reqd": 1, "in_list_view": 1},
    {"fieldname": "customer_mobile", "fieldtype": "Data", "label": "Customer Mobile", "reqd": 1},
    {"fieldname": "col_break1", "fieldtype": "Column Break"},
    {"fieldname": "customer_email", "fieldtype": "Data", "label": "Customer Email", "options": "Email"},
    {"fieldname": "no_of_passengers", "fieldtype": "Int", "label": "No. of Passengers", "default": 1},
    {"fieldname": "special_requirements", "fieldtype": "Small Text", "label": "Special Requirements"},
    {"fieldname": "section_break2", "fieldtype": "Section Break", "label": "Trip Details"},
    {"fieldname": "pickup_location", "fieldtype": "Data", "label": "Pickup Location", "reqd": 1},
    {"fieldname": "pickup_datetime", "fieldtype": "Datetime", "label": "Pickup Date & Time", "reqd": 1},
    {"fieldname": "col_break2", "fieldtype": "Column Break"},
    {"fieldname": "drop_location", "fieldtype": "Data", "label": "Drop Location", "reqd": 1},
    {"fieldname": "expected_drop_datetime", "fieldtype": "Datetime", "label": "Expected Drop Date & Time"},
    {"fieldname": "trip_type", "fieldtype": "Select", "label": "Trip Type",
     "options": "One Way\nRound Trip\nLocal Package\nAirport Transfer", "default": "One Way"},
    {"fieldname": "estimated_distance", "fieldtype": "Float", "label": "Estimated Distance (KM)"},
    {"fieldname": "section_break3", "fieldtype": "Section Break", "label": "Vehicle & Driver"},
    {"fieldname": "vehicle_category", "fieldtype": "Link", "label": "Vehicle Category", "options": "Vehicle Category", "reqd": 1},
    {"fieldname": "vehicle", "fieldtype": "Link", "label": "Assigned Vehicle", "options": "Vehicle"},
    {"fieldname": "col_break3", "fieldtype": "Column Break"},
    {"fieldname": "driver", "fieldtype": "Link", "label": "Assigned Driver", "options": "Driver"},
    {"fieldname": "driver_name", "fieldtype": "Data", "label": "Driver Name", "read_only": 1, "fetch_from": "driver.driver_name"},
    {"fieldname": "driver_mobile", "fieldtype": "Data", "label": "Driver Mobile", "read_only": 1, "fetch_from": "driver.mobile_number"},
    {"fieldname": "section_break4", "fieldtype": "Section Break", "label": "Fare & Payment"},
    {"fieldname": "base_fare", "fieldtype": "Currency", "label": "Base Fare"},
    {"fieldname": "distance_charge", "fieldtype": "Currency", "label": "Distance Charge"},
    {"fieldname": "extra_charges", "fieldtype": "Currency", "label": "Extra Charges", "default": 0},
    {"fieldname": "col_break4", "fieldtype": "Column Break"},
    {"fieldname": "discount_amount", "fieldtype": "Currency", "label": "Discount", "default": 0},
    {"fieldname": "tax_amount", "fieldtype": "Currency", "label": "Tax (GST)", "read_only": 1},
    {"fieldname": "total_fare", "fieldtype": "Currency", "label": "Total Fare", "read_only": 1, "in_list_view": 1},
    {"fieldname": "payment_status", "fieldtype": "Select", "label": "Payment Status",
     "options": "Unpaid\nPartially Paid\nPaid\nRefunded", "default": "Unpaid", "in_list_view": 1},
    {"fieldname": "payment_method", "fieldtype": "Select", "label": "Payment Method",
     "options": "\nCash\nCard\nUPI\nNet Banking\nWallet"},
    {"fieldname": "paid_amount", "fieldtype": "Currency", "label": "Paid Amount", "default": 0},
    {"fieldname": "section_break5", "fieldtype": "Section Break", "label": "Trip Execution"},
    {"fieldname": "actual_pickup_time", "fieldtype": "Datetime", "label": "Actual Pickup Time"},
    {"fieldname": "actual_drop_time", "fieldtype": "Datetime", "label": "Actual Drop Time"},
    {"fieldname": "col_break5", "fieldtype": "Column Break"},
    {"fieldname": "actual_distance", "fieldtype": "Float", "label": "Actual Distance (KM)"},
    {"fieldname": "customer_rating", "fieldtype": "Int", "label": "Customer Rating (1-5)"},
    {"fieldname": "customer_feedback", "fieldtype": "Small Text", "label": "Customer Feedback"},
    {"fieldname": "cancellation_reason", "fieldtype": "Small Text", "label": "Cancellation Reason"},
    {"fieldname": "section_break6", "fieldtype": "Section Break", "label": "Internal Notes"},
    {"fieldname": "internal_notes", "fieldtype": "Small Text", "label": "Internal Notes"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1},
    {"role": "Vehicle Booking Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
    {"role": "Vehicle Booking User", "read": 1, "write": 1, "create": 1},
    {"role": "Customer", "read": 1, "write": 1, "create": 1, "permlevel": 0}
  ]
}
